{%- liquid
  assign s = section.settings
  assign band = ''
  if s.band == 'cream'
    assign band = ' nexa-band'
  elsif s.band == 'dark'
    assign band = ' nexa-band nexa-band--dark'
  endif
-%}

<div class="section-background{{ band }}"></div>

<div
  class="section section--{{ s.section_width }} spacing-style{{ band }}"
  style="{% render 'spacing-style', settings: s %}"
>
  {%- if s.heading != blank -%}
    <div class="nexa-head nexa-head--center">
      <div>
        {%- if s.eyebrow != blank -%}
          <p class="nexa-eyebrow nexa-eyebrow--center">{{ s.eyebrow }}</p>
        {%- endif -%}
        <h2 class="nexa-title">{{ s.heading }}</h2>
      </div>
    </div>
  {%- endif -%}

  <div class="nexa-stats">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <span class="nexa-stat__num">{{ block.settings.value }}</span>
        <span class="nexa-stat__label">{{ block.settings.label }}</span>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Nexa stats",
  "tag": "section",
  "class": "nexa-section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "12,000+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Gifts delivered" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "band",
      "label": "Background",
      "options": [
        { "value": "none", "label": "Page background" },
        { "value": "cream", "label": "Cream" },
        { "value": "dark", "label": "Ink" }
      ],
      "default": "cream"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 140, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 140, "step": 2, "unit": "px", "default": 56 }
  ],
  "presets": [
    {
      "name": "Nexa stats",
      "category": "Storytelling",
      "blocks": [
        { "type": "stat", "settings": { "value": "12,000+", "label": "Gifts delivered" } },
        { "type": "stat", "settings": { "value": "4.8/5", "label": "Average rating" } },
        { "type": "stat", "settings": { "value": "64", "label": "Districts covered" } },
        { "type": "stat", "settings": { "value": "48 hrs", "label": "Typical delivery" } }
      ]
    }
  ]
}
{% endschema %}
