{%- liquid
  assign s = section.settings
  assign band = ''
  if s.band == 'cream'
    assign band = ' nexa-band'
  elsif s.band == 'dark'
    assign band = ' nexa-band nexa-band--dark'
  endif
-%}

<div class="section-background{{ band }}"></div>

<div
  class="section section--{{ s.section_width }} spacing-style{{ band }}"
  style="{% render 'spacing-style', settings: s %}"
>
  {%- if s.heading != blank or s.link_label != blank -%}
    <div class="nexa-head{% if s.align == 'center' %} nexa-head--center{% endif %}">
      <div>
        {%- if s.eyebrow != blank -%}
          <p class="nexa-eyebrow{% if s.align == 'center' %} nexa-eyebrow--center{% endif %}">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="nexa-title">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.subheading != blank -%}
          <p class="nexa-sub">{{ s.subheading }}</p>
        {%- endif -%}
      </div>
      {%- if s.link_label != blank -%}
        <a class="nexa-link" href="{{ s.link_url | default: '#' }}">
          {{ s.link_label }}
          {% render 'nexa-icon', name: 'arrow-right', size: 15 %}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="nexa-cats" style="--nexa-cols: {{ s.columns }};">
    {%- for block in section.blocks -%}
      {%- liquid
        assign bs = block.settings
        assign col = collections[bs.collection]
        assign url = bs.link
        if url == blank and col != blank
          assign url = col.url
        endif
        assign title = bs.title
        if title == blank and col != blank
          assign title = col.title
        endif
      -%}
      <a class="nexa-cat" href="{{ url | default: '#' }}" {{ block.shopify_attributes }}>
        {%- if bs.tag != blank -%}
          <span class="nexa-cat__tag">{{ bs.tag }}</span>
        {%- endif -%}

        <span class="nexa-cat__media">
          {%- if bs.image != blank -%}
            {{
              bs.image
              | image_url: width: 800
              | image_tag: widths: '300,400,600,800', sizes: '(max-width: 600px) 50vw, 30vw', loading: 'lazy', alt: title
            }}
          {%- elsif col != blank and col.featured_image != blank -%}
            {{
              col.featured_image
              | image_url: width: 800
              | image_tag: widths: '300,400,600,800', sizes: '(max-width: 600px) 50vw, 30vw', loading: 'lazy', alt: title
            }}
          {%- else -%}
            <img
              src="{{ bs.art | asset_url }}"
              alt="{{ title | escape }}"
              width="400"
              height="500"
              loading="lazy"
            >
          {%- endif -%}
        </span>

        <span class="nexa-cat__body">
          <span>
            <span class="nexa-cat__name">{{ title | default: 'Category' }}</span>
            {%- if bs.caption != blank -%}
              <span class="nexa-cat__count">{{ bs.caption }}</span>
            {%- elsif col != blank and s.show_count -%}
              <span class="nexa-cat__count">
                {{ col.products_count }} {% if col.products_count == 1 %}product{% else %}products{% endif %}
              </span>
            {%- endif -%}
          </span>
          <span class="nexa-cat__arrow">{% render 'nexa-icon', name: 'arrow-right', size: 15 %}</span>
        </span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Nexa categories",
  "tag": "section",
  "class": "nexa-section",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "caption", "label": "Caption override", "info": "Replaces the product count." },
        { "type": "url", "id": "link", "label": "Link override" },
        { "type": "text", "id": "tag", "label": "Corner badge" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Falls back to the collection image, then the bundled illustration." },
        {
          "type": "select",
          "id": "art",
          "label": "Bundled illustration",
          "options": [
            { "value": "nexa-cat-wallets.svg", "label": "Wallets" },
            { "value": "nexa-cat-watches.svg", "label": "Watches" },
            { "value": "nexa-cat-rings.svg", "label": "Rings" },
            { "value": "nexa-cat-sunglasses.svg", "label": "Sunglasses" },
            { "value": "nexa-cat-beauty.svg", "label": "Beauty" },
            { "value": "nexa-cat-gift-sets.svg", "label": "Gift sets" }
          ],
          "default": "nexa-cat-wallets.svg"
        }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Five ways to say you thought about it" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all categories" },
    { "type": "url", "id": "link_url", "label": "Link" },
    {
      "type": "select",
      "id": "align",
      "label": "Header alignment",
      "options": [
        { "value": "split", "label": "Split" },
        { "value": "center", "label": "Centered" }
      ],
      "default": "split"
    },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true },
    {
      "type": "select",
      "id": "band",
      "label": "Background",
      "options": [
        { "value": "none", "label": "Page background" },
        { "value": "cream", "label": "Cream" },
        { "value": "dark", "label": "Ink" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 140, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 140, "step": 2, "unit": "px", "default": 60 }
  ],
  "presets": [
    {
      "name": "Nexa categories",
      "category": "Collections",
      "blocks": [
        { "type": "category", "settings": { "title": "Wallets", "art": "nexa-cat-wallets.svg", "caption": "Leather, slim & RFID" } },
        { "type": "category", "settings": { "title": "Watches", "art": "nexa-cat-watches.svg", "caption": "Classic & everyday" } },
        { "type": "category", "settings": { "title": "Rings", "art": "nexa-cat-rings.svg", "caption": "Couple & statement" } },
        { "type": "category", "settings": { "title": "Sunglasses", "art": "nexa-cat-sunglasses.svg", "caption": "UV400 polarised" } },
        { "type": "category", "settings": { "title": "Beauty", "art": "nexa-cat-beauty.svg", "caption": "Skincare & fragrance" } },
        { "type": "category", "settings": { "title": "Gift sets", "art": "nexa-cat-gift-sets.svg", "caption": "Ready to give", "tag": "Best value" } }
      ]
    }
  ]
}
{% endschema %}
