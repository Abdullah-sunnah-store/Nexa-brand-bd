{
  "type": "footer",
  "name": "t:names.footer",
  "sections": {
    "footer_main": {
      "type": "footer",
      "blocks": {
        "brand": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "horizontal_alignment_flex_direction_column": "flex-start",
            "gap": 14,
            "width": "fill",
            "height": "fit"
          },
          "blocks": {
            "name": {
              "type": "text",
              "settings": {
                "text": "<h3>NexaBrand BD</h3>",
                "width": "100%",
                "max_width": "none",
                "alignment": "left",
                "type_preset": "h4",
                "font": "var(--font-heading--family)"
              }
            },
            "blurb": {
              "type": "text",
              "settings": {
                "text": "<p>Wallets, watches, rings, sunglasses and beauty — hand-picked, gift-boxed and delivered across all 64 districts of Bangladesh.</p>",
                "width": "100%",
                "max_width": "none",
                "alignment": "left",
                "type_preset": "rte",
                "font_size": "0.875rem"
              }
            },
            "socials": {
              "type": "social-links",
              "settings": {
                "facebook_url": "https://www.facebook.com/",
                "instagram_url": "https://www.instagram.com/",
                "youtube_url": "https://www.youtube.com/",
                "tiktok_url": "https://www.tiktok.com/"
              }
            },
            "payments": {
              "type": "payment-icons",
              "settings": {
                "horizontal_alignment": "flex-start",
                "gap": 8,
                "padding-block-start": 6
              }
            }
          },
          "block_order": ["name", "blurb", "socials", "payments"]
        },
        "shop_menu": {
          "type": "menu",
          "settings": {
            "menu": "main-menu",
            "heading": "Shop",
            "menu_spacing": 10,
            "show_as_accordion": true,
            "accordion_icon": "plus",
            "accordion_dividers": false,
            "heading_preset": "h6",
            "link_preset": "paragraph"
          }
        },
        "help_menu": {
          "type": "menu",
          "settings": {
            "menu": "footer",
            "heading": "Help",
            "menu_spacing": 10,
            "show_as_accordion": true,
            "accordion_icon": "plus",
            "accordion_dividers": false,
            "heading_preset": "h6",
            "link_preset": "paragraph"
          }
        },
        "contact": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "horizontal_alignment_flex_direction_column": "flex-start",
            "gap": 12,
            "width": "fill",
            "height": "fit"
          },
          "blocks": {
            "heading": {
              "type": "text",
              "settings": {
                "text": "<h3>Stay in touch</h3>",
                "width": "100%",
                "max_width": "none",
                "alignment": "left",
                "type_preset": "h6",
                "font": "var(--font-subheading--family)",
                "case": "uppercase",
                "letter_spacing": "loose"
              }
            },
            "details": {
              "type": "text",
              "settings": {
                "text": "<p>WhatsApp <a href=\"tel:+8801700000000\">+880 1700-000000</a><br>10am – 9pm, every day<br><a href=\"mailto:hello@nexabrandbd.com\">hello@nexabrandbd.com</a></p>",
                "width": "100%",
                "max_width": "none",
                "alignment": "left",
                "type_preset": "rte",
                "font_size": "0.875rem"
              }
            },
            "signup_label": {
              "type": "text",
              "settings": {
                "text": "<p>Get 10% off your first order.</p>",
                "width": "100%",
                "max_width": "none",
                "alignment": "left",
                "type_preset": "rte",
                "font_size": "0.875rem",
                "padding-block-start": 4
              }
            },
            "signup": {
              "type": "email-signup",
              "settings": {
                "width": "fill",
                "border_style": "all",
                "input_style": "default",
                "border_width": 1,
                "border_radius": 100,
                "input_type_preset": "paragraph",
                "style_class": "button-unstyled",
                "display_type": "arrow",
                "label": "Sign up",
                "integrated_button": true,
                "button_type_preset": "paragraph"
              }
            }
          },
          "block_order": ["heading", "details", "signup_label", "signup"]
        }
      },
      "block_order": ["brand", "shop_menu", "help_menu", "contact"],
      "name": "t:names.footer",
      "settings": {
        "section_width": "page-width",
        "gap": 32,
        "background_color": "#141210",
        "padding-block-start": 64,
        "padding-block-end": 40
      }
    },
    "footer_utilities": {
      "type": "footer-utilities",
      "blocks": {
        "copyright": {
          "type": "footer-copyright",
          "settings": {
            "show_powered_by": false,
            "font_size": "0.75rem",
            "case": "none"
          }
        },
        "policies": {
          "type": "footer-policy-list",
          "settings": {
            "font_size": "0.75rem",
            "case": "none"
          }
        }
      },
      "block_order": ["copyright", "policies"],
      "name": "t:names.utilities",
      "settings": {
        "section_width": "page-width",
        "gap": 24,
        "divider_thickness": 1,
        "divider_color": "#3a332b",
        "background_color": "#141210",
        "padding-block-start": 20,
        "padding-block-end": 40
      }
    }
  },
  "order": ["footer_main", "footer_utilities"]
}
