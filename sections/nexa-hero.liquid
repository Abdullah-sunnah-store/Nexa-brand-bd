{%- liquid
  assign s = section.settings
  assign band = ''
  if s.band == 'cream'
    assign band = ' nexa-band'
  elsif s.band == 'dark'
    assign band = ' nexa-band nexa-band--dark'
  endif
-%}

<div class="section-background{{ band }}"></div>

<div
  class="section section--{{ s.section_width }} spacing-style{{ band }}"
  style="{% render 'spacing-style', settings: s %}"
>
  <div class="nexa-hero">
    <div class="nexa-hero__copy">
      {%- if s.eyebrow != blank -%}
        <p class="nexa-eyebrow">{{ s.eyebrow }}</p>
      {%- endif -%}

      <h1 class="nexa-hero__title">
        {{ s.heading }}
        {%- if s.heading_accent != blank -%}
          <em>{{ s.heading_accent }}</em>
        {%- endif -%}
      </h1>

      {%- if s.body != blank -%}
        <div class="nexa-hero__text">{{ s.body }}</div>
      {%- endif -%}

      {%- if s.button_label != blank or s.button_2_label != blank -%}
        <div class="nexa-actions">
          {%- if s.button_label != blank -%}
            <a class="nexa-btn" href="{{ s.button_link | default: '#' }}">
              {{ s.button_label }}
              {% render 'nexa-icon', name: 'arrow-right', size: 17 %}
            </a>
          {%- endif -%}
          {%- if s.button_2_label != blank -%}
            <a class="nexa-btn nexa-btn--ghost" href="{{ s.button_2_link | default: '#' }}">
              {{ s.button_2_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.meta_1 != blank or s.meta_2 != blank or s.meta_3 != blank -%}
        <div class="nexa-hero__meta">
          {%- if s.meta_1 != blank -%}
            <div>{% render 'nexa-icon', name: s.meta_1_icon, size: 17 %}<span>{{ s.meta_1 }}</span></div>
          {%- endif -%}
          {%- if s.meta_2 != blank -%}
            <div>{% render 'nexa-icon', name: s.meta_2_icon, size: 17 %}<span>{{ s.meta_2 }}</span></div>
          {%- endif -%}
          {%- if s.meta_3 != blank -%}
            <div>{% render 'nexa-icon', name: s.meta_3_icon, size: 17 %}<span>{{ s.meta_3 }}</span></div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="nexa-hero__art">
      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 1200
          | image_tag: widths: '400,600,800,1000,1200', sizes: '(max-width: 899px) 100vw, 45vw', loading: 'eager', fetchpriority: 'high', alt: s.image.alt | default: s.heading
        }}
      {%- else -%}
        <img
          src="{{ 'nexa-hero.svg' | asset_url }}"
          alt="{{ s.heading | escape }}"
          width="800"
          height="1000"
          loading="eager"
          fetchpriority="high"
        >
      {%- endif -%}

      {%- if s.badge != blank -%}
        <span class="nexa-hero__badge">{{ s.badge }}</span>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Nexa hero",
  "tag": "section",
  "class": "nexa-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Gifts for every occasion" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gifts they will" },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent line",
      "info": "Shown underneath the heading in italic gold.",
      "default": "actually remember."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Wallets, watches, rings, sunglasses and beauty — hand-picked, gift-boxed and delivered across Bangladesh. Cash on delivery available nationwide.</p>"
    },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the bundled illustration." },
    { "type": "text", "id": "badge", "label": "Image badge", "default": "Free gift wrap" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop all gifts" },
    { "type": "url", "id": "button_link", "label": "Primary link" },
    { "type": "text", "id": "button_2_label", "label": "Secondary button", "default": "Explore gift sets" },
    { "type": "url", "id": "button_2_link", "label": "Secondary link" },
    { "type": "header", "content": "Trust row" },
    {
      "type": "select",
      "id": "meta_1_icon",
      "label": "Item 1 icon",
      "options": [
        { "value": "truck", "label": "Delivery truck" },
        { "value": "cash", "label": "Cash" },
        { "value": "return", "label": "Return" },
        { "value": "shield", "label": "Shield" },
        { "value": "gift", "label": "Gift" },
        { "value": "star", "label": "Star" },
        { "value": "lock", "label": "Lock" },
        { "value": "headset", "label": "Support" },
        { "value": "clock", "label": "Clock" },
        { "value": "sparkle", "label": "Sparkle" }
      ],
      "default": "truck"
    },
    { "type": "text", "id": "meta_1", "label": "Item 1 text", "default": "Free delivery over ৳2,000" },
    {
      "type": "select",
      "id": "meta_2_icon",
      "label": "Item 2 icon",
      "options": [
        { "value": "truck", "label": "Delivery truck" },
        { "value": "cash", "label": "Cash" },
        { "value": "return", "label": "Return" },
        { "value": "shield", "label": "Shield" },
        { "value": "gift", "label": "Gift" },
        { "value": "star", "label": "Star" },
        { "value": "lock", "label": "Lock" },
        { "value": "headset", "label": "Support" },
        { "value": "clock", "label": "Clock" },
        { "value": "sparkle", "label": "Sparkle" }
      ],
      "default": "cash"
    },
    { "type": "text", "id": "meta_2", "label": "Item 2 text", "default": "Cash on delivery" },
    {
      "type": "select",
      "id": "meta_3_icon",
      "label": "Item 3 icon",
      "options": [
        { "value": "truck", "label": "Delivery truck" },
        { "value": "cash", "label": "Cash" },
        { "value": "return", "label": "Return" },
        { "value": "shield", "label": "Shield" },
        { "value": "gift", "label": "Gift" },
        { "value": "star", "label": "Star" },
        { "value": "lock", "label": "Lock" },
        { "value": "headset", "label": "Support" },
        { "value": "clock", "label": "Clock" },
        { "value": "sparkle", "label": "Sparkle" }
      ],
      "default": "return"
    },
    { "type": "text", "id": "meta_3", "label": "Item 3 text", "default": "7-day easy returns" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "band",
      "label": "Background",
      "options": [
        { "value": "none", "label": "Page background" },
        { "value": "cream", "label": "Cream" },
        { "value": "dark", "label": "Ink" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 8 }
  ],
  "presets": [{ "name": "Nexa hero", "category": "Banners" }]
}
{% endschema %}
