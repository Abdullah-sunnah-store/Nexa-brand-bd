{%- liquid
  assign s = section.settings
  assign band = ''
  if s.band == 'cream'
    assign band = ' nexa-band'
  elsif s.band == 'dark'
    assign band = ' nexa-band nexa-band--dark'
  endif
-%}

<div class="section-background{{ band }}"></div>

<div
  class="section section--{{ s.section_width }} spacing-style{{ band }}"
  style="{% render 'spacing-style', settings: s %}"
>
  {%- if s.heading != blank -%}
    <div class="nexa-head{% if s.align == 'center' %} nexa-head--center{% endif %}">
      <div>
        {%- if s.eyebrow != blank -%}
          <p class="nexa-eyebrow{% if s.align == 'center' %} nexa-eyebrow--center{% endif %}">{{ s.eyebrow }}</p>
        {%- endif -%}
        <h2 class="nexa-title">{{ s.heading }}</h2>
        {%- if s.subheading != blank -%}
          <p class="nexa-sub">{{ s.subheading }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="nexa-info">
    {%- for block in section.blocks -%}
      <div
        class="nexa-info__card{% if block.settings.accent %} nexa-info__card--accent{% endif %}"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.icon != 'none' -%}
          <span class="nexa-info__icon">{% render 'nexa-icon', name: block.settings.icon, size: 21 %}</span>
        {%- endif -%}
        <h3>{{ block.settings.title }}</h3>
        <div>{{ block.settings.text }}</div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Nexa info columns",
  "tag": "section",
  "class": "nexa-section",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Delivery truck" },
            { "value": "cash", "label": "Cash" },
            { "value": "return", "label": "Return" },
            { "value": "shield", "label": "Shield" },
            { "value": "gift", "label": "Gift" },
            { "value": "star", "label": "Star" },
            { "value": "lock", "label": "Lock" },
            { "value": "phone", "label": "Phone" },
            { "value": "mail", "label": "Mail" },
            { "value": "pin", "label": "Map pin" },
            { "value": "clock", "label": "Clock" },
            { "value": "headset", "label": "Support" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "diamond", "label": "Diamond" },
            { "value": "box", "label": "Box" },
            { "value": "tag", "label": "Tag" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Delivery" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Dhaka in 24-48 hours. Rest of Bangladesh in 2-4 working days.</p>" },
        { "type": "checkbox", "id": "accent", "label": "Cream background", "default": false }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    {
      "type": "select",
      "id": "align",
      "label": "Header alignment",
      "options": [
        { "value": "split", "label": "Split" },
        { "value": "center", "label": "Centered" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "band",
      "label": "Background",
      "options": [
        { "value": "none", "label": "Page background" },
        { "value": "cream", "label": "Cream" },
        { "value": "dark", "label": "Ink" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 140, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 140, "step": 2, "unit": "px", "default": 48 }
  ],
  "presets": [
    {
      "name": "Nexa info columns",
      "category": "Storytelling",
      "blocks": [
        { "type": "column", "settings": { "icon": "truck", "title": "Delivery", "text": "<p>Dhaka in 24-48 hours. Rest of Bangladesh in 2-4 working days. Free over ৳2,000.</p>" } },
        { "type": "column", "settings": { "icon": "cash", "title": "Payment", "text": "<p>Cash on delivery, bKash, Nagad, Rocket, or card. Prepaid orders ship first.</p>" } },
        { "type": "column", "settings": { "icon": "return", "title": "Returns", "text": "<p>7 days to change your mind. Unused, in its box, and we will collect it.</p>" } },
        { "type": "column", "settings": { "icon": "headset", "title": "Support", "text": "<p>Message us on WhatsApp 10am-9pm. A real person replies, usually inside an hour.</p>" } }
      ]
    }
  ]
}
{% endschema %}
