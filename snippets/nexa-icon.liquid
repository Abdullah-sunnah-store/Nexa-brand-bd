{%- doc -%}
  Renders one of the NexaBrand line icons as inline SVG.

  @param {string} name - Icon key. Unknown keys render nothing.
  @param {number} [size] - Square size in px. Defaults to 20.

  @example
  {% render 'nexa-icon', name: 'truck', size: 22 %}
{%- enddoc -%}

{%- liquid
  assign s = size | default: 20
  assign filled = false
  if name == 'star' or name == 'sparkle'
    assign filled = true
  endif
-%}

{%- capture paths -%}
  {%- case name -%}
    {%- when 'truck' -%}
      <path d="M2 7.5A1.5 1.5 0 0 1 3.5 6h9A1.5 1.5 0 0 1 14 7.5V17H2z" /><path d="M14 10h3.6a2 2 0 0 1 1.7.96L21.5 15v2H14z" /><circle cx="6" cy="17.5" r="2" /><circle cx="17.5" cy="17.5" r="2" />
    {%- when 'cash' -%}
      <rect x="2" y="6" width="20" height="12" rx="2" /><circle cx="12" cy="12" r="2.6" /><path d="M6 10v4M18 10v4" />
    {%- when 'return' -%}
      <path d="M3 11a9 9 0 1 1 2.6 6.4" /><path d="M3 6v5h5" />
    {%- when 'shield' -%}
      <path d="M12 3l7.5 3v5.5c0 4.6-3.1 8.2-7.5 9.5-4.4-1.3-7.5-4.9-7.5-9.5V6z" /><path d="M9 12l2.2 2.2L15.5 10" />
    {%- when 'gift' -%}
      <rect x="3" y="9" width="18" height="12" rx="1.5" /><path d="M2.5 9h19M12 9v12" /><path d="M12 9C10.5 6 8.6 3.6 6.9 4.2 5.5 4.7 5.7 7.2 7.6 8c1.4.6 3.3.9 4.4 1z" /><path d="M12 9c1.5-3 3.4-5.4 5.1-4.8 1.4.5 1.2 3-.7 3.8-1.4.6-3.3.9-4.4 1z" />
    {%- when 'star' -%}
      <path d="M12 2.6l2.9 5.9 6.5.95-4.7 4.6 1.1 6.45L12 17.45 6.2 20.5l1.1-6.45-4.7-4.6 6.5-.95z" />
    {%- when 'lock' -%}
      <rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7.5a4 4 0 0 1 8 0V10" /><path d="M12 14.2v1.6" />
    {%- when 'phone' -%}
      <path d="M6.2 3h3l1.5 4-2 1.3a12 12 0 0 0 5 5l1.3-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.2 5.2 2 2 0 0 1 6.2 3z" />
    {%- when 'mail' -%}
      <rect x="2.5" y="5" width="19" height="14" rx="2" /><path d="M3 7l9 6 9-6" />
    {%- when 'pin' -%}
      <path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11z" /><circle cx="12" cy="10" r="2.6" />
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9" /><path d="M12 7v5.3l3.3 2" />
    {%- when 'sparkle' -%}
      <path d="M12 2l1.9 5.9L20 10l-6.1 2.1L12 18l-1.9-5.9L4 10l6.1-2.1z" /><path d="M19 15.5l.9 2.6 2.6.9-2.6.9-.9 2.6-.9-2.6-2.6-.9 2.6-.9z" opacity="0.6" />
    {%- when 'check' -%}
      <path d="M4.5 12.5l4.5 4.5L19.5 6.5" />
    {%- when 'check-circle' -%}
      <circle cx="12" cy="12" r="9" /><path d="M8.2 12.3l2.6 2.6 5-5.2" />
    {%- when 'arrow-right' -%}
      <path d="M4.5 12h15M13.5 6l6 6-6 6" />
    {%- when 'diamond' -%}
      <path d="M12 3l8 7-8 11-8-11z" /><path d="M4 10h16M9 10l3 11M15 10l-3 11" />
    {%- when 'headset' -%}
      <path d="M4 14v-2a8 8 0 0 1 16 0v2" /><rect x="2.5" y="13.5" width="4" height="6" rx="1.6" /><rect x="17.5" y="13.5" width="4" height="6" rx="1.6" /><path d="M19.5 19.5v.5a2.5 2.5 0 0 1-2.5 2.5H13" />
    {%- when 'tag' -%}
      <path d="M3 12.5V4a1 1 0 0 1 1-1h8.5L21 11.5 12.5 20z" /><circle cx="7.8" cy="7.8" r="1.4" />
    {%- when 'box' -%}
      <path d="M3 7.5L12 3l9 4.5V17L12 21l-9-4.5z" /><path d="M3 7.5L12 12l9-4.5M12 12v9" />
  {%- endcase -%}
{%- endcapture -%}

{%- if paths != blank -%}
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="{{ s }}"
    height="{{ s }}"
    viewBox="0 0 24 24"
    fill="{% if filled %}currentColor{% else %}none{% endif %}"
    {% unless filled %}
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    {% endunless %}
    aria-hidden="true"
    focusable="false"
  >
    {{ paths }}
  </svg>
{%- endif -%}
