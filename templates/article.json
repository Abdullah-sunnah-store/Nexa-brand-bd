{
  "sections": {
    "section": {
      "type": "main-blog-post",
      "blocks": {
        "blog-post-title": {
          "type": "text",
          "name": "t:names.title",
          "settings": {
            "text": "<h1>{{ article.title }}</h1>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "h2",
            "font": "var(--font-heading--family)",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "blog-post-details": {
          "type": "_blog-post-info-text",
          "name": "t:names.details",
          "settings": {
            "show_date": true,
            "show_author": false,
            "alignment": "center",
            "show_alignment": true,
            "padding-block-start": 0,
            "padding-block-end": 0
          },
          "blocks": {}
        },
        "blog-post-image": {
          "type": "image",
          "name": "t:names.featured_image",
          "settings": {
            "image": "{{ article.image }}",
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "blog-post-content": {
          "type": "_blog-post-content",
          "settings": {},
          "blocks": {}
        }
      },
      "block_order": [
        "blog-post-title",
        "blog-post-details",
        "blog-post-image",
        "blog-post-content"
      ],
      "settings": {
        "content_direction": "column",
        "gap": 32,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 40,
        "padding-block-end": 80
      }
    },
    "promise": {
      "type": "nexa-usp-bar",
      "blocks": {
        "u1": {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Nationwide delivery",
            "text": "Dhaka in 24-48 hrs, rest of Bangladesh in 2-4 days."
          }
        },
        "u2": {
          "type": "item",
          "settings": {
            "icon": "cash",
            "title": "Cash on delivery",
            "text": "Pay the courier when your gift arrives at the door."
          }
        },
        "u3": {
          "type": "item",
          "settings": {
            "icon": "gift",
            "title": "Free gift wrap",
            "text": "Box, ribbon and a message card on every order."
          }
        },
        "u4": {
          "type": "item",
          "settings": {
            "icon": "return",
            "title": "7-day returns",
            "text": "Unused and in its box? Send it back, no questions."
          }
        }
      },
      "block_order": [
        "u1",
        "u2",
        "u3",
        "u4"
      ],
      "settings": {
        "band": "none",
        "section_width": "page-width",
        "padding-block-start": 24,
        "padding-block-end": 24
      }
    },
    "newsletter": {
      "type": "nexa-newsletter",
      "settings": {
        "eyebrow": "The list",
        "heading": "Get 10% off your",
        "heading_accent": "first gift.",
        "body": "<p>New arrivals, restocks and the occasional quiet sale. One email a week at most.</p>",
        "placeholder": "Your email address",
        "button_label": "Send my code",
        "note": "No spam. Unsubscribe any time.",
        "success_text": "You are in. Check your inbox for the code.",
        "section_width": "page-width",
        "padding-block-start": 24,
        "padding-block-end": 80
      }
    }
  },
  "order": [
    "section",
    "promise",
    "newsletter"
  ]
}
