    "faq": {
      "type": "nexa-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Inside Dhaka, 24 to 48 hours. Anywhere else in Bangladesh, 2 to 4 working days. You get an SMS with the courier's number as soon as the parcel leaves us.</p>",
            "open": true
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Can I pay cash on delivery?",
            "answer": "<p>Yes, everywhere in Bangladesh. You can also pay with bKash, Nagad, Rocket or any Visa / Mastercard at checkout. Prepaid orders ship first.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Is the gift wrapping really free?",
            "answer": "<p>It is. Every order goes out in a Nexa box with a ribbon and a blank message card. Add your message in the order notes at checkout and we will write it for you.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "What if it does not fit, or they do not like it?",
            "answer": "<p>Send it back within 7 days, unused and in its original box, and we will exchange it or refund you. Ring sizing exchanges are free.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Are the watches and sunglasses authentic?",
            "answer": "<p>Every piece is sourced direct from the brand or its authorised distributor, then checked by hand before it ships. Anything that fails the check never reaches you.</p>"
          }
        }
      },
      "block_order": ["q1", "q2", "q3", "q4", "q5"],
      "settings": {
        "eyebrow": "Good to know",
        "heading": "Questions we get every day",
        "band": "none",
        "section_width": "page-width",
        "padding-block-start": 64,
        "padding-block-end": 40
