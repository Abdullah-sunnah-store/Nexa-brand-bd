{
  "sections": {
    "main": {
      "type": "main-404",
      "blocks": {
        "code": {
          "type": "text",
          "settings": {
            "text": "<p>404</p>",
            "width": "fit-content",
            "alignment": "center",
            "type_preset": "custom",
            "font": "var(--font-heading--family)",
            "font_size": "1rem",
            "letter_spacing": "loose",
            "case": "uppercase"
          }
        },
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h1>This gift is not where you left it</h1>",
            "width": "fit-content",
            "max_width": "narrow",
            "alignment": "center",
            "type_preset": "h2",
            "font": "var(--font-heading--family)",
            "wrap": "balance"
          }
        },
        "body": {
          "type": "text",
          "settings": {
            "text": "<p>The page you were after has moved, sold out, or never existed. Try the search, or start again from a category.</p>",
            "width": "fit-content",
            "max_width": "narrow",
            "alignment": "center",
            "type_preset": "rte"
          }
        },
        "button": {
          "type": "button",
          "settings": {
            "label": "Back to shopping",
            "link": "shopify://collections/all",
            "style_class": "button",
            "width": "fit-content"
          }
        }
      },
      "block_order": ["code", "heading", "body", "button"],
      "settings": {
        "content_direction": "column",
        "section_width": "page-width",
        "section_height": "medium",
        "horizontal_alignment_flex_direction_column": "center",
        "vertical_alignment_flex_direction_column": "center",
        "gap": 16,
        "padding-block-start": 64,
        "padding-block-end": 32
      }
    },
    "categories": {
      "type": "nexa-categories",
      "blocks": {
        "c1": { "type": "category", "settings": { "collection": "wallets", "title": "Wallets", "art": "nexa-cat-wallets.svg" } },
        "c2": { "type": "category", "settings": { "collection": "watches", "title": "Watches", "art": "nexa-cat-watches.svg" } },
        "c3": { "type": "category", "settings": { "collection": "rings", "title": "Rings", "art": "nexa-cat-rings.svg" } },
        "c4": { "type": "category", "settings": { "collection": "sunglasses", "title": "Sunglasses", "art": "nexa-cat-sunglasses.svg" } },
        "c5": { "type": "category", "settings": { "collection": "beauty", "title": "Beauty", "art": "nexa-cat-beauty.svg" } },
        "c6": { "type": "category", "settings": { "collection": "gift-sets", "title": "Gift sets", "art": "nexa-cat-gift-sets.svg" } }
      },
      "block_order": ["c1", "c2", "c3", "c4", "c5", "c6"],
      "settings": {
        "eyebrow": "Try one of these",
        "heading": "Pick up where you meant to",
        "link_label": "",
        "align": "center",
        "columns": 3,
        "show_count": false,
        "band": "none",
        "section_width": "page-width",
        "padding-block-start": 24,
        "padding-block-end": 40
      }
    },
    "bestsellers": {
      "type": "product-list",
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "static": true,
          "settings": {
            "content_direction": "row",
            "horizontal_alignment": "space-between",
            "vertical_alignment": "flex-end"
          },
          "blocks": {
            "heading": {
              "type": "_product-list-text",
              "settings": {
                "text": "<h3>Best sellers</h3>",
                "type_preset": "h4",
                "font": "var(--font-heading--family)",
                "alignment": "left"
              }
            }
          },
          "block_order": ["heading"]
        },
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "settings": { "product_card_gap": 6 },
          "blocks": {
            "gallery": {
              "type": "_product-card-gallery",
              "settings": { "image_ratio": "portrait", "border_radius": 12 }
            },
            "title": {
              "type": "product-title",
              "settings": {
                "width": "100%",
                "alignment": "left",
                "type_preset": "rte",
                "font_size": "0.9375rem",
                "padding-block-start": 8
              }
            },
            "price": {
              "type": "price",
              "settings": { "type_preset": "h6", "alignment": "left", "font_size": "0.9375rem" }
            }
          },
          "block_order": ["gallery", "title", "price"]
        }
      },
      "settings": {
        "collection": "best-sellers",
        "layout_type": "grid",
        "carousel_on_mobile": true,
        "max_products": 4,
        "columns": 4,
        "mobile_columns": "2",
        "columns_gap": 16,
        "rows_gap": 32,
        "section_width": "page-width",
        "gap": 24,
        "padding-block-start": 24,
        "padding-block-end": 80
      }
    }
  },
  "order": ["main", "categories", "bestsellers"]
}
