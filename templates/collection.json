{
  "sections": {
    "collection_hero": {
      "type": "nexa-page-hero",
      "settings": {
        "source": "collection",
        "show_breadcrumbs": true,
        "band": "none",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "main": {
      "type": "main-collection",
      "blocks": {
        "filters": {
          "type": "filters",
          "static": true,
          "settings": {}
        },
        "product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 6
          },
          "blocks": {
            "card-gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "portrait",
                "border_radius": 12
              }
            },
            "card-title": {
              "type": "product-title",
              "settings": {
                "width": "100%",
                "alignment": "left",
                "type_preset": "rte",
                "font_size": "0.9375rem",
                "padding-block-start": 8
              }
            },
            "card-price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "type_preset": "h6",
                "alignment": "left",
                "font_size": "0.9375rem"
              }
            }
          },
          "block_order": ["card-gallery", "card-title", "card-price"]
        }
      },
      "settings": {
        "layout_type": "grid",
        "product_card_size": "medium",
        "mobile_product_card_size": "small",
        "enable_infinite_scroll": false,
        "products_per_page": 24,
        "product_grid_width": "centered",
        "columns_gap_horizontal": 16,
        "columns_gap_vertical": 32,
        "padding-block-start": 32,
        "padding-block-end": 48
      }
    },
    "promise": {
      "type": "nexa-usp-bar",
      "blocks": {
        "u1": {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Nationwide delivery",
            "text": "Dhaka in 24-48 hrs, rest of Bangladesh in 2-4 days."
          }
        },
        "u2": {
          "type": "item",
          "settings": {
            "icon": "cash",
            "title": "Cash on delivery",
            "text": "Pay the courier when your gift arrives at the door."
          }
        },
        "u3": {
          "type": "item",
          "settings": {
            "icon": "gift",
            "title": "Free gift wrap",
            "text": "Box, ribbon and a message card on every order."
          }
        },
        "u4": {
          "type": "item",
          "settings": {
            "icon": "return",
            "title": "7-day returns",
            "text": "Unused and in its box? Send it back, no questions."
          }
        }
      },
      "block_order": ["u1", "u2", "u3", "u4"],
      "settings": {
        "band": "none",
        "section_width": "page-width",
        "padding-block-start": 8,
        "padding-block-end": 56
      }
    },
    "newsletter": {
      "type": "nexa-newsletter",
      "settings": {
        "eyebrow": "The list",
        "heading": "Get 10% off your",
        "heading_accent": "first gift.",
        "body": "<p>New arrivals, restocks and the occasional quiet sale. One email a week at most.</p>",
        "placeholder": "Your email address",
        "button_label": "Send my code",
        "note": "No spam. Unsubscribe any time.",
        "success_text": "You are in. Check your inbox for the code.",
        "section_width": "page-width",
        "padding-block-start": 8,
        "padding-block-end": 80
      }
    }
  },
  "order": ["collection_hero", "main", "promise", "newsletter"]
}
