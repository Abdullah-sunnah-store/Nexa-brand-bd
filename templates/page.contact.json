    "faq": {
      "type": "nexa-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Where is my order?",
            "answer": "<p>You get an SMS with the courier's number the moment your parcel leaves us. If it has been longer than the estimate, send us your order number on WhatsApp and we will chase it for you.</p>",
            "open": true
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Can I change or cancel an order?",
            "answer": "<p>Yes, as long as it has not been handed to the courier. Message us quickly with the order number. Once it is out for delivery, you can simply refuse it at the door.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Do you do corporate gifting?",
            "answer": "<p>We do — 20 pieces and up, with your logo on the box if you want it, and a proper invoice. Email <a href=\"mailto:corporate@nexabrandbd.com\">corporate@nexabrandbd.com</a> with your quantity and date.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Can I collect instead of paying delivery?",
            "answer": "<p>Yes. Choose local pickup at checkout and collect from Banani between 11am and 8pm. We will message you when it is ready.</p>"
          }
        }
      },
      "block_order": ["q1", "q2", "q3", "q4"],
      "settings": {
        "eyebrow": "Before you write",
        "heading": "This might answer it faster",
        "band": "cream",
        "section_width": "page-width",
        "padding-block-start": 64,
