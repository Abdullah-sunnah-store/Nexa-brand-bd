{
  "sections": {
    "main": {
      "type": "product-information",
      "blocks": {
        "media-gallery": {
          "type": "_product-media-gallery",
          "static": true,
          "settings": {}
        },
        "product-details": {
          "type": "_product-details",
          "static": true,
          "blocks": {
            "head": {
              "type": "group",
              "settings": {
                "content_direction": "column",
                "horizontal_alignment_flex_direction_column": "flex-start",
                "gap": 8,
                "width": "fill",
                "padding-block-end": 4
              },
              "blocks": {
                "title": {
                  "type": "product-title",
                  "settings": {
                    "width": "100%",
                    "alignment": "left",
                    "type_preset": "h3",
                    "font": "var(--font-heading--family)"
                  }
                },
                "stars": {
                  "type": "review",
                  "settings": {
                    "stars_style": "shaded",
                    "show_number": true,
                    "type_preset": "paragraph",
                    "width": "100%",
                    "alignment": "left"
                  }
                },
                "price": {
                  "type": "price",
                  "settings": {
                    "show_sale_price_first": true,
                    "show_installments": false,
                    "show_tax_info": false,
                    "type_preset": "h4",
                    "width": "100%",
                    "alignment": "left"
                  }
                }
              },
              "block_order": ["title", "stars", "price"]
            },
            "divider_top": {
              "type": "_divider",
              "settings": {
                "thickness": 1,
                "width_percent": 100,
                "padding-block-start": 8,
                "padding-block-end": 8
              }
            },
            "variants": {
              "type": "variant-picker",
              "settings": {
                "variant_style": "buttons",
                "show_swatches": true,
                "alignment": "left",
                "padding-block-end": 8
              }
            },
            "buy": {
              "type": "buy-buttons",
              "settings": {
                "stacking": false,
                "show_pickup_availability": true,
                "gift_card_form": true,
                "padding-block-start": 8,
                "padding-block-end": 8
              },
              "blocks": {
                "quantity": { "type": "quantity", "static": true, "settings": {} },
                "add-to-cart": { "type": "add-to-cart", "static": true, "settings": {} },
                "accelerated-checkout": { "type": "accelerated-checkout", "static": true, "settings": {} }
              }
            },
            "inventory": {
              "type": "product-inventory",
              "settings": {
                "inventory_threshold": 8,
                "show_inventory_quantity": true,
                "padding-block-end": 8
              }
            },
            "trust": {
              "type": "text",
              "settings": {
                "text": "<p>Free gift box and message card · Cash on delivery available · 7-day returns</p>",
                "width": "100%",
                "max_width": "none",
                "alignment": "left",
                "type_preset": "paragraph",
                "font_size": "0.8125rem",
                "background": true,
                "background_color": "#f6efe3",
                "corner_radius": 10,
                "padding-block-start": 12,
                "padding-block-end": 12,
                "padding-inline-start": 14,
                "padding-inline-end": 14
              }
            },
            "details_accordion": {
              "type": "accordion",
              "settings": {
                "icon": "plus",
                "dividers": true,
                "type_preset": "h6",
                "padding-block-start": 16
              },
              "blocks": {
                "row_desc": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Description",
                    "open_by_default": true,
                    "icon": "none"
                  },
                  "blocks": {
                    "desc": {
                      "type": "product-description",
                      "settings": {
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "rte"
                      }
                    }
                  },
                  "block_order": ["desc"]
                },
                "row_delivery": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Delivery & payment",
                    "icon": "truck"
                  },
                  "blocks": {
                    "txt": {
                      "type": "text",
                      "settings": {
                        "text": "<p><strong>Dhaka:</strong> 24–48 hours. <strong>Rest of Bangladesh:</strong> 2–4 working days.</p><p>Delivery is free on orders over ৳2,000, otherwise ৳60 inside Dhaka and ৳120 outside.</p><p>Pay cash on delivery, or prepay with bKash, Nagad, Rocket or card. Prepaid orders are dispatched first.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "rte"
                      }
                    }
                  },
                  "block_order": ["txt"]
                },
                "row_returns": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Returns & exchange",
                    "icon": "return"
                  },
                  "blocks": {
                    "txt": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Changed your mind? You have 7 days from delivery. The item must be unused and in its original box with all tags.</p><p>Ring size exchanges are free. For anything else we cover the return courier if the fault is ours, otherwise it is ৳100.</p><p>Beauty products can only be returned unopened and sealed.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "rte"
                      }
                    }
                  },
                  "block_order": ["txt"]
                },
                "row_authentic": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Authenticity & care",
                    "icon": "check_box"
                  },
                  "blocks": {
                    "txt": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Every piece is sourced from the brand or its authorised distributor and inspected by hand before it ships.</p><p><strong>Leather:</strong> keep dry, wipe with a soft cloth. <strong>Watches:</strong> avoid hot water; splash-resistant is not swim-proof. <strong>Jewellery:</strong> store dry, remove before perfume. <strong>Eyewear:</strong> clean with the pouch, never your shirt.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "rte"
                      }
                    }
                  },
                  "block_order": ["txt"]
                }
              },
              "block_order": ["row_desc", "row_delivery", "row_returns", "row_authentic"]
            },
            "sku": {
              "type": "sku",
              "settings": {}
            }
          },
          "block_order": [
            "head",
            "divider_top",
            "variants",
            "buy",
            "inventory",
            "trust",
            "details_accordion",
            "sku"
          ]
        }
      },
      "block_order": [],
      "settings": {
        "content_width": "content-center-aligned",
        "desktop_media_position": "left",
        "equal_columns": false,
        "limit_details_width": true,
        "gap": 56,
        "enable_sticky_add_to_cart": true,
        "padding-block-start": 32,
        "padding-block-end": 32
      }
    },
    "promise": {
      "type": "nexa-info-columns",
      "blocks": {
        "i1": {
          "type": "column",
          "settings": {
            "icon": "truck",
            "title": "Delivery",
            "text": "<p>Dhaka in 24-48 hours, rest of Bangladesh in 2-4 working days. Free over ৳2,000.</p>",
            "accent": false
          }
        },
        "i2": {
          "type": "column",
          "settings": {
            "icon": "cash",
            "title": "Payment",
            "text": "<p>Cash on delivery, bKash, Nagad, Rocket or card. Prepaid orders ship first.</p>",
            "accent": false
          }
        },
        "i3": {
          "type": "column",
          "settings": {
            "icon": "return",
            "title": "Returns",
            "text": "<p>7 days to change your mind. Unused, in its box, and we will collect it.</p>",
            "accent": false
          }
        },
        "i4": {
          "type": "column",
          "settings": {
            "icon": "gift",
            "title": "Gift ready",
            "text": "<p>Free box, ribbon and message card. Add your note in the order comments.</p>",
            "accent": true
          }
        }
      },
      "block_order": ["i1", "i2", "i3", "i4"],
      "settings": {
        "align": "center",
        "band": "none",
        "section_width": "page-width",
        "padding-block-start": 24,
        "padding-block-end": 48
      }
    },
    "recommendations": {
      "type": "product-recommendations",
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h3>Goes well with this</h3>",
            "width": "100%",
            "alignment": "left",
            "type_preset": "h4",
            "font": "var(--font-heading--family)"
          }
        }
      },
      "block_order": ["heading"],
      "settings": {
        "recommendation_type": "related",
        "layout_type": "carousel",
        "carousel_on_mobile": true,
        "max_products": 8,
        "columns_gap": 16,
        "rows_gap": 24,
        "gap": 24,
        "padding-block-start": 48,
        "padding-block-end": 48
      }
    },
    "faq": {
      "type": "nexa-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Will it arrive gift-wrapped?",
            "answer": "<p>Yes. Every order ships in a rigid Nexa box with a ribbon and a blank message card, at no extra cost. Leave your message in the order notes and we will write it in for you.</p>",
            "open": true
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Can I get it delivered on a specific date?",
            "answer": "<p>Add the date to your order notes. For birthdays, anniversaries and Eid we hold the parcel and hand it to the courier so it lands on the morning you asked for.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "What if the size is wrong?",
            "answer": "<p>Ring and bracelet exchanges are free within 7 days. Message us on WhatsApp with your order number and we will arrange the swap and the pickup.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Do you have a warranty?",
            "answer": "<p>Watches carry a 12-month warranty on the movement. Everything else is covered for 6 months against manufacturing faults. Wear and tear, water damage and accidental damage are not covered.</p>"
          }
        }
      },
      "block_order": ["q1", "q2", "q3", "q4"],
      "settings": {
        "eyebrow": "Before you buy",
        "heading": "Common questions",
        "band": "cream",
        "section_width": "page-width",
        "padding-block-start": 64,
        "padding-block-end": 64
      }
    }
  },
  "order": ["main", "promise", "recommendations", "faq"]
}
